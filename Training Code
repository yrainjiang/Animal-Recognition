import tensorflow as tf
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt

# Use the directory where images are downloaded and organized by species
BASE  = output_image_dir # This should be whatever directory you saved the files from iNaturalist
IMG   = (256, 256) # The images are higher resolution because many animals have more details
BATCH = 32

#Prepare data
gen = ImageDataGenerator(
    rescale=1./255,
    validation_split=0.1,
    rotation_range=10,
    brightness_range=[0.9, 1.1],
    zoom_range=[0.9, 1.1]
)

train = gen.flow_from_directory(BASE, target_size=IMG, batch_size=BATCH, class_mode="binary", subset="training",  shuffle=True)
val = gen.flow_from_directory(BASE, target_size=IMG, batch_size=BATCH, class_mode="binary", subset="validation", shuffle=False)

labels = list(train.class_indices.keys())
print("Classes:", labels)

#Build model
model = models.Sequential([
    layers.Conv2D(32,  (3,3), activation='relu', input_shape=IMG+(3,)),
    layers.MaxPooling2D(2, 2),
    layers.Conv2D(64,  (3,3), activation='relu'),
    layers.MaxPooling2D(2, 2),
    layers.Conv2D(128, (3,3), activation='relu'),
    layers.Flatten(),
    layers.Dense(128, activation='relu'),
    layers.Dense(1, activation='sigmoid') # Changed to 1 neuron for binary classification
])

model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
model.summary()

#Train
history = model.fit(train, validation_data=val, epochs=10)

model.save(DRIVE_MODEL_PATH, save_format='keras') # Use DRIVE_MODEL_PATH and specify format
